rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User-specific snapshots: Private research history
    // Only the owner can read or write to their own snapshot collection.
    match /users/{userId}/snapshots/{snapshotId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public gallery: Shared simulation results
    // - Any authenticated user can read public snapshots.
    // - Any authenticated user can create a public snapshot, but only if they assign themselves as the owner.
    // - Only the owner of the snapshot can delete it.
    match /public_snapshots/{snapshotId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false; // Public records are immutable after creation
    }
  }
}
